# ==========================================
# 🚀 Desktop AI Assistant - Environment Vars
# ==========================================

# --- 1. PostgreSQL Database Setup ---
POSTGRES_USER=your_postgres_username
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name
DATABASE_URL=postgresql://your_postgres_username:your_postgres_password@localhost:5432/your_database_name

# --- 2. Security & Authentication ---
# Generate a strong random key (e.g., using `openssl rand -hex 32`)
SECRET_KEY=replace_this_with_a_32_character_hex_string
ALGORITHM=HS256

# --- 3. Groq API Key (The Brains) ---
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here